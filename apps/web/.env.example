# On Netlify, set these in Site configuration > Environment variables (never commit real values).
# The database connection is provided by Netlify automatically.

# Signs login sessions. 32+ random characters, e.g. from: openssl rand -base64 48
SESSION_SECRET=

# Encrypts residents' National ID Numbers. 32+ random characters. NEVER change it once
# residents have registered — existing NINs could no longer be decrypted. Back it up safely.
NIN_ENCRYPTION_KEY=

# Africa's Talking — "sandbox" while testing
AT_USERNAME=sandbox
AT_API_KEY=
AT_SENDER_ID=

# Comma-separated phones that become SafeNest super admin when they sign in
SUPER_ADMIN_PHONES=+2567XXXXXXXX

# Testing only: these numbers sign in with TEST_OTP_CODE (a secret 6-digit code you choose,
# never 123456) and no SMS is sent. Turn off before real users.
ALLOW_TEST_OTP=false
TEST_OTP_CODE=
TEST_OTP_NUMBERS=+256700000100,+256700000200,+256700000300

# Optional
EXPO_ACCESS_TOKEN=

# Security limits (defaults shown)
# OTP_IP_HOURLY_LIMIT=10        # codes per network address per hour
# OTP_GLOBAL_HOURLY_LIMIT=300   # all codes per hour (stops SMS-cost attacks)
# NIN_SEARCH_DAILY_LIMIT=20     # NIN searches per officer per 24 hours
# NIN_SEARCH_ALERT_AT=10        # highlight officers above this in the audit page
# Emergency only: phones listed here have their PIN cleared at next sign-in. Remove after use.
# PIN_RESET_PHONES=

# Data retention in days (defaults shown). Audit log is kept 730 days.
# RETENTION_EVIDENCE_DAYS=90    # after the case is closed
# RETENTION_COMMUNITY_DAYS=30
# RETENTION_VISITOR_DAYS=180
# RETENTION_NOTIFICATION_DAYS=180
# RETENTION_PASS_DAYS=90        # after the pass expires

# Local runs only (not on Netlify):
# DATABASE_URL=postgres://...
# EVIDENCE_LOCAL_DIR=.data/evidence
