# Copy to supabase/functions/.env for local serving, or set in the cloud with
#   npx supabase secrets set KEY=value ...

# Africa's Talking — use "sandbox" + the sandbox API key while testing
AT_USERNAME=sandbox
AT_API_KEY=your-africastalking-api-key
# Approved alphanumeric sender ID (e.g. SAFENEST). Leave empty until approved.
AT_SENDER_ID=

# From Supabase Dashboard > Authentication > Hooks > Send SMS hook (starts with v1,whsec_)
SEND_SMS_HOOK_SECRET=v1,whsec_replace_me

# Optional: Expo access token if you enable "enhanced push security" in Expo
EXPO_ACCESS_TOKEN=

# Where the web dashboard lives; included in SOS SMS so staff can open the alert
DASHBOARD_URL=http://localhost:3000
