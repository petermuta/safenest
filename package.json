{
  "name": "safenest",
  "private": true,
  "version": "0.1.0",
  "description": "SafeNest \u2014 estate security and management for Uganda",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "web": "npm run dev --workspace @safenest/web",
    "mobile": "npm run start --workspace @safenest/mobile",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build --workspace @safenest/web",
    "test:db": "node netlify/database/tests/flows.test.mjs",
    "test:e2e": "node scripts/e2e.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15"
  },
  "dependencies": {
    "@netlify/database": "^2.0.3"
  }
}
